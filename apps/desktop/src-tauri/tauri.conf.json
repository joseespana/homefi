{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeFi",
  "identifier": "com.perseusoft.homefi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HomeFi",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://resources.tidal.com cover: http://cover.localhost http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Tidal downloader and hi-fi music player",
    "longDescription": "Download your Tidal library in lossless quality and play it on any output: USB DACs, headphones or Bluetooth.",
    "copyright": "Copyright Perseusoft",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "linux": {
      "deb": { "depends": ["libasound2"] },
      "rpm": { "depends": ["alsa-lib"] }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0REY3REI4N0RCNUEyM0EKUldRNm9yVjl1SDNmQkFkWE1ZeGZIcnVjdzVXNFpWZk90KzZiYkJsMlN5OG0zN1RXVkJLWUNMWlAK",
      "endpoints": ["https://github.com/joseespana/homefi/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
