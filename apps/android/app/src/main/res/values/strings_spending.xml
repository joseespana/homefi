    <!-- AI spending: what each AI action cost, "ask before spending" and the monthly limit -->
    <string name="spend_title">Spending</string>
    <string name="spend_intro">What the AI has cost you, counted on this device. Amounts with ≈ are estimates from the model\'s list price; your AI service\'s bill is what counts.</string>
    <string name="spend_month">This month</string>
    <plurals name="spend_month_actions">
        <item quantity="one">%1$d AI action</item>
        <item quantity="other">%1$d AI actions</item>
