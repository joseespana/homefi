    <string name="spend_guard_title">Ask before spending</string>
    <string name="spend_guard_intro">So the AI never uses up your balance by surprise. The monthly limit is checked on every AI call.</string>
    <string name="spend_ask">Ask before an AI action</string>
    <string name="spend_ask_never">Don\'t ask</string>
    <string name="spend_ask_always">Always</string>
    <string name="spend_ask_above">Above an amount</string>
