    <plurals name="spend_month_unknown">
        <item quantity="one">%1$d without a known price, not counted</item>
        <item quantity="other">%1$d without a known price, not counted</item>
    </plurals>
    <string name="spend_nothing">Nothing yet</string>
    <string name="spend_nothing_hint">Every AI action (a ride, a concert, a party playlist, the sound assistant…) shows up here with what it cost.</string>
    <string name="spend_balance">Left on OpenRouter</string>
    <string name="spend_balance_check">Check balance</string>
