    <string name="spend_ask_always_hint">You\'ll see what it usually costs and confirm before every AI action.</string>
    <string name="spend_ask_above_hint">Asks only when it usually costs more than the amount, or nobody knows yet.</string>
    <string name="spend_ask_above_amount">Ask when it costs more than %1$s</string>
