<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (16:9): the app's mark on its dark background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0A121D"
                android:endColor="#0B3A4A" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp" />
</layer-list>
